# Copy to .env (never commit .env) or run `tcconcierge setup` and answer
# a few plain-language questions — it writes .env for you.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your cars: nickname=VIN pairs, comma-separated. A nickname alone works too
# (add the VIN later at pairing time). Find a VIN in the Tesla app under
# Controls -> Software.
TCC_VEHICLES=Model Y=,Model 3=

# The chat server this app exposes (OpenAI-compatible).
TCC_SERVER_HOST=127.0.0.1
TCC_SERVER_PORT=8643
TCC_SERVER_API_KEY=
TCC_MODEL_ID=tesla-climate-concierge

# Pluggable AI backend (any OpenAI-compatible API). Default: local Ollama.
# Set TCC_AI_MODE=never for built-in answers only — nothing leaves this computer.
TCC_AI_BASE_URL=http://localhost:11434/v1
TCC_AI_API_KEY=
TCC_AI_MODEL=llama3.1
TCC_AI_MODE=auto
TCC_AI_TIMEOUT_SECONDS=20
TCC_EMBEDDING_DIM=384
TCC_TOKEN_FILE=~/.tcc/tokens.json
TCC_DRY_RUN=0

# Climate-concierge defaults.
TCC_DEFAULT_TEMP_F=70
TCC_COP_REARM=1
